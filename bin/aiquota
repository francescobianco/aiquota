#!/bin/sh
# shellcheck disable=SC2016 # the hooks printed by `init` must expand later
# AIQuota - remaining quota of your flat-rate AI subscriptions, in your terminal.
#
# Scope: flat subscriptions only, whose quota is measured as resources left until
# the next reset. Pay-per-token API keys are deliberately not supported, so a
# provider must report RC_HIDDEN when it detects one.
#
# Nothing is auto-detected: only the accounts named in --display are queried and
# shown, in that order.
#
# Portability: POSIX sh + awk + curl. No bashisms, no `local`, no jq. Functions
# that need private variables use the `name() ( ... )` subshell form.
#
# Safety rules that every provider must keep:
#   - credentials are read only, never written back and never refreshed: refresh
#     tokens may rotate, and using one here could log the user out of their agent
#   - tokens travel through curl's stdin config, never on argv (visible in `ps`)
#   - everything received from the network is stripped of control characters
#     before being cached, because it ends up in the terminal and in the prompt
#   - curl never follows redirects, so tokens cannot leak to another host

set -u
umask 077

AIQUOTA_VERSION=0.1.0
SELF=$0 # here, because zsh changes $0 inside functions
TAB=$(printf '\t')

CONFIG_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/aiquota/config
# shellcheck disable=SC1090
[ -r "$CONFIG_FILE" ] && . "$CONFIG_FILE"

AIQUOTA_DISPLAY=${AIQUOTA_DISPLAY:-}
KNOWN_ACCOUNTS="claude codex gemini copilot opencode freebuff"
AIQUOTA_TTL=${AIQUOTA_TTL:-300}
AIQUOTA_TIMEOUT=${AIQUOTA_TIMEOUT:-8}
AIQUOTA_BANNER=${AIQUOTA_BANNER:-1}
AIQUOTA_TITLE=${AIQUOTA_TITLE:-1}
CACHE_DIR=${AIQUOTA_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/aiquota}

# Provider exit codes.
RC_OK=0
RC_HIDDEN=10 # not logged in, or not a flat subscription
RC_AUTH=11   # the login expired: the user has to open the agent once
RC_ERROR=12  # network or API failure: keep showing the last known values

# ---------------------------------------------------------------- helpers ----

now() {
	date +%s 2>/dev/null || awk 'BEGIN { srand(); print srand() }'
}

# Flatten JSON from stdin into "path<TAB>value" lines, e.g. a.b.0.c<TAB>42.
# Nulls are dropped. Bytes mode keeps substr() O(1) on multibyte-aware awks.
json_flatten() {
	LC_ALL=C awk '
	function skip() { while (p <= n && index(" \t\r\n", substr(s, p, 1))) p++ }
	function str(   out, c) {
		p++; out = ""
		while (p <= n) {
			c = substr(s, p, 1)
			if (c == "\"") { p++; return out }
			if (c == "\\") {
				p++; c = substr(s, p, 1)
				if (c == "u") { p += 4; c = "?" }
				else if (c == "n" || c == "t" || c == "r" || c == "b" || c == "f") c = " "
			}
			out = out c; p++
		}
		return out
	}
	function val(path,   c, k, i, st) {
		skip(); c = substr(s, p, 1)
		if (c == "{") {
			p++; skip()
			if (substr(s, p, 1) == "}") { p++; return }
			while (p <= n) {
				skip(); k = str(); skip(); p++
				val(path == "" ? k : path "." k)
				skip(); c = substr(s, p, 1); p++
				if (c != ",") return
			}
		} else if (c == "[") {
			p++; skip()
			if (substr(s, p, 1) == "]") { p++; return }
			i = 0
			while (p <= n) {
				val(path == "" ? i : path "." i); i++
				skip(); c = substr(s, p, 1); p++
				if (c != ",") return
			}
		} else if (c == "\"") {
			k = str(); print path "\t" k
		} else {
			st = p
			while (p <= n && !index(",}] \t\r\n", substr(s, p, 1))) p++
			k = substr(s, st, p - st)
			if (k != "null" && k != "") print path "\t" k
			if (p == st) p++
		}
	}
	{ s = s $0 "\n" }
	END { n = length(s); p = 1; val("") }'
}

# Read a value from flattened JSON on stdin.
kv() {
	awk -F "$TAB" -v k="$1" '$1 == k { sub(/^[^\t]*\t/, ""); print; exit }'
}

# Read one path from a variable holding flattened JSON. printf is a builtin, so
# the data never reaches argv.
get() {
	printf '%s\n' "$1" | kv "$2"
}

# Accept only characters that are safe inside a curl config header.
safe_token() {
	case $1 in '' | *[!A-Za-z0-9_.~+/=:-]*) return 1 ;; esac
	return 0
}

# ISO-8601 (date only, or date-time with Z or an offset) to epoch. Plain
# arithmetic, because GNU and BSD `date` disagree on how to parse dates.
iso_epoch() {
	printf '%s\n' "$1" | awk '
	{
		y = substr($0, 1, 4) + 0; m = substr($0, 6, 2) + 0; d = substr($0, 9, 2) + 0
		if (y < 1970 || m < 1 || m > 12 || d < 1 || d > 31) exit
		H = M = S = off = 0
		if (length($0) >= 19) {
			H = substr($0, 12, 2) + 0; M = substr($0, 15, 2) + 0; S = substr($0, 18, 2) + 0
			t = substr($0, 20)
			if (match(t, /[-+][0-9][0-9]:?[0-9][0-9]$/)) {
				z = substr(t, RSTART + 1); gsub(/:/, "", z)
				off = substr(z, 1, 2) * 3600 + substr(z, 3, 2) * 60
				if (substr(t, RSTART, 1) == "-") off = -off
			}
		}
		if (m <= 2) { y--; m += 12 }
		era = int(y / 400); yoe = y - era * 400
		doy = int((153 * (m - 3) + 2) / 5) + d - 1
		doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
		printf "%.0f\n", (era * 146097 + doe - 719468) * 86400 + H * 3600 + M * 60 + S - off
	}'
}

calc() {
	awk -v a="$1" -v b="${2:-0}" -v op="$3" 'BEGIN {
		if (op == "left") printf "%.2f\n", 100 - a
		else if (op == "pct" && b > 0) printf "%.2f\n", a / b * 100
	}'
}

# "plus_team" -> "Plus Team"
pretty() {
	printf '%s\n' "$1" | tr '_-' '  ' | awk '{
		for (i = 1; i <= NF; i++) $i = toupper(substr($i, 1, 1)) substr($i, 2)
		print
	}'
}

window_label() {
	if [ "$1" -ge 86400 ]; then
		printf '%sd' "$(($1 / 86400))"
	elif [ "$1" -ge 3600 ]; then
		printf '%sh' "$(($1 / 3600))"
	else
		printf '%sm' "$(($1 / 60))"
	fi
}

# True if a millisecond timestamp has passed. In awk, because shells such as mksh
# have 32-bit arithmetic.
ms_expired() {
	[ -n "$1" ] && awk -v e="$1" -v n="$(now)" 'BEGIN { exit !(e / 1000 <= n) }'
}

emit_plan() { printf 'plan\t%s\n' "$1"; }
emit_msg() { printf 'msg\t%s\n' "$1"; }
emit_win() { printf 'win\t%s\t%s\t%s\n' "$1" "$2" "${3:-0}"; }

# http METHOD URL [BODY]: curl config lines on stdin, response in $AQ_BODY,
# status on stdout ("000" when the request could not be made).
http() {
	if [ $# -ge 3 ]; then
		curl -sS -m "$AIQUOTA_TIMEOUT" -K - -o "$AQ_BODY" -w '%{http_code}' -X "$1" \
			-H 'Content-Type: application/json' -d "$3" "$2" 2>/dev/null
	else
		curl -sS -m "$AIQUOTA_TIMEOUT" -K - -o "$AQ_BODY" -w '%{http_code}' -X "$1" \
			"$2" 2>/dev/null
	fi
}

# Map an HTTP status to a provider exit code, printing the reason.
http_failure() {
	case $1 in
	401 | 403)
		emit_msg "$2"
		return "$RC_AUTH"
		;;
	429) emit_msg "rate limited, showing last known values" ;;
	000) emit_msg "offline, showing last known values" ;;
	*) emit_msg "HTTP $1, showing last known values" ;;
	esac
	return "$RC_ERROR"
}

# -------------------------------------------------------------- providers ----
#
# To add a provider: write provider_<name>() and add <name> to KNOWN_ACCOUNTS.
# It prints `plan` and `win` lines (emit_plan, emit_win), and returns one of the
# RC_* codes. See CONTRIBUTING.md.

provider_claude() (
	file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json
	if [ -r "$file" ]; then
		creds=$(json_flatten <"$file")
	elif command -v security >/dev/null 2>&1; then
		creds=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null | json_flatten)
	else
		creds=
	fi

	# API-key users have no claudeAiOauth entry, so they stay hidden.
	sub=$(get "$creds" claudeAiOauth.subscriptionType)
	token=$(get "$creds" claudeAiOauth.accessToken)
	[ -n "$sub" ] && safe_token "$token" || return "$RC_HIDDEN"

	case $(get "$creds" claudeAiOauth.rateLimitTier) in
	*max_5x*) plan="Max 5x" ;;
	*max_20x*) plan="Max 20x" ;;
	*) plan=$(pretty "$sub") ;;
	esac
	emit_plan "$plan"

	expires=$(get "$creds" claudeAiOauth.expiresAt)
	if ms_expired "$expires"; then
		emit_msg "login expired, open claude once to renew it"
		return "$RC_AUTH"
	fi

	code=$(printf 'header = "Authorization: Bearer %s"\nheader = "anthropic-beta: oauth-2025-04-20"\n' "$token" |
		http GET https://api.anthropic.com/api/oauth/usage)
	[ "$code" = 200 ] || {
		http_failure "$code" "login rejected, open claude once to renew it"
		return
	}

	data=$(json_flatten <"$AQ_BODY")
	for pair in five_hour:5h seven_day:7d; do
		key=${pair%:*}
		used=$(get "$data" "$key.utilization")
		[ -n "$used" ] || continue
		emit_win "${pair#*:}" "$used" "$(iso_epoch "$(get "$data" "$key.resets_at")")"
	done
)

provider_codex() (
	file=${CODEX_HOME:-$HOME/.codex}/auth.json
	[ -r "$file" ] || return "$RC_HIDDEN"
	creds=$(json_flatten <"$file")

	# auth_mode "apikey" is pay-per-token and out of scope.
	case $(get "$creds" auth_mode) in '' | chatgpt) ;; *) return "$RC_HIDDEN" ;; esac
	token=$(get "$creds" tokens.access_token)
	account=$(get "$creds" tokens.account_id)
	safe_token "$token" || return "$RC_HIDDEN"

	if [ -n "$account" ] && safe_token "$account"; then
		code=$(printf 'header = "Authorization: Bearer %s"\nheader = "ChatGPT-Account-Id: %s"\nheader = "User-Agent: aiquota"\n' "$token" "$account" |
			http GET https://chatgpt.com/backend-api/wham/usage)
	else
		code=$(printf 'header = "Authorization: Bearer %s"\nheader = "User-Agent: aiquota"\n' "$token" |
			http GET https://chatgpt.com/backend-api/wham/usage)
	fi
	[ "$code" = 200 ] || {
		http_failure "$code" "login expired, open codex once to renew it"
		return
	}

	data=$(json_flatten <"$AQ_BODY")
	plan=$(get "$data" plan_type)
	case $plan in *usage_based*) return "$RC_HIDDEN" ;; esac # metered, not flat
	emit_plan "$(pretty "${plan:-unknown}")"

	for slot in primary_window secondary_window; do
		used=$(get "$data" "rate_limit.$slot.used_percent")
		[ -n "$used" ] || continue
		secs=$(get "$data" "rate_limit.$slot.limit_window_seconds")
		case ${secs:-x} in *[!0-9]*) label=$slot ;; *) label=$(window_label "$secs") ;; esac
		emit_win "$label" "$used" "$(get "$data" "rate_limit.$slot.reset_at")"
	done
)

provider_gemini() (
	file=$HOME/.gemini/oauth_creds.json
	[ -r "$file" ] || return "$RC_HIDDEN"
	creds=$(json_flatten <"$file")
	token=$(get "$creds" access_token)
	safe_token "$token" || return "$RC_HIDDEN"

	expires=$(get "$creds" expiry_date)
	if ms_expired "$expires"; then
		# Old credentials of a removed CLI should not nag forever.
		command -v gemini >/dev/null 2>&1 || return "$RC_HIDDEN"
		emit_msg "login expired, open gemini once to renew it"
		return "$RC_AUTH"
	fi

	api=https://cloudcode-pa.googleapis.com/v1internal
	code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
		http POST "${api}:loadCodeAssist" '{"metadata":{"ideType":"GEMINI_CLI","pluginType":"GEMINI"}}')
	[ "$code" = 200 ] || {
		http_failure "$code" "login rejected, open gemini once to renew it"
		return
	}
	data=$(json_flatten <"$AQ_BODY")

	# Since June 2026 Google serves this only to Standard and Enterprise seats.
	tier=$(get "$data" currentTier.name)
	[ -n "$tier" ] || return "$RC_HIDDEN"
	emit_plan "$tier"
	project=$(get "$data" cloudaicompanionProject)
	case $project in *[!A-Za-z0-9-]*) project= ;; esac

	code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
		http POST "${api}:retrieveUserQuota" "{\"project\":\"$project\"}")
	[ "$code" = 200 ] || {
		http_failure "$code" "quota not available for this account"
		return
	}

	# Keep the most consumed bucket of each model family.
	json_flatten <"$AQ_BODY" | awk -F "$TAB" '
	$1 ~ /^buckets\.[0-9]+\./ {
		split($1, a, "."); i = a[2]
		if (i + 1 > n) n = i + 1
		if (a[3] == "modelId") model[i] = $2
		else if (a[3] == "remainingFraction") frac[i] = $2 + 0
		else if (a[3] == "resetTime") when[i] = $2
	}
	END {
		for (i = 0; i < n; i++) {
			f = (model[i] ~ /flash/) ? "flash" : (model[i] ~ /pro/) ? "pro" : ""
			if (f == "" || !(i in frac)) continue
			if (!(f in best) || frac[i] < best[f]) { best[f] = frac[i]; reset[f] = when[i] }
		}
		if ("pro" in best) print "pro\t" (1 - best["pro"]) * 100 "\t" reset["pro"]
		if ("flash" in best) print "flash\t" (1 - best["flash"]) * 100 "\t" reset["flash"]
	}' | while IFS="$TAB" read -r label used reset; do
		emit_win "$label" "$used" "$(iso_epoch "$reset")"
	done
)

provider_copilot() (
	file=${XDG_CONFIG_HOME:-$HOME/.config}/github-copilot/apps.json
	[ -r "$file" ] || file=${XDG_CONFIG_HOME:-$HOME/.config}/github-copilot/hosts.json
	[ -r "$file" ] || file=${LOCALAPPDATA:-/nonexistent}/github-copilot/apps.json
	[ -r "$file" ] || return "$RC_HIDDEN"

	token=$(json_flatten <"$file" | awk -F "$TAB" '$1 ~ /(^|\.)oauth_token$/ { print $2; exit }')
	safe_token "$token" || return "$RC_HIDDEN"

	code=$(printf 'header = "Authorization: token %s"\nheader = "User-Agent: aiquota"\nheader = "Accept: application/json"\n' "$token" |
		http GET https://api.github.com/copilot_internal/user)
	[ "$code" = 200 ] || {
		http_failure "$code" "login expired, sign in to Copilot again"
		return
	}

	data=$(json_flatten <"$AQ_BODY")
	[ "$(get "$data" access_type_sku)" != no_access ] || return "$RC_HIDDEN"
	emit_plan "$(pretty "$(get "$data" copilot_plan)")"

	reset=$(get "$data" quota_reset_date_utc)
	[ -n "$reset" ] || reset=$(get "$data" quota_reset_date)
	epoch=$(iso_epoch "$reset")
	for pair in premium_interactions:premium chat:chat; do
		key=quota_snapshots.${pair%:*}
		[ "$(get "$data" "$key.unlimited")" != true ] || continue
		left=$(get "$data" "$key.percent_remaining")
		[ -n "$left" ] || continue
		emit_win "${pair#*:}" "$(calc "$left" 0 left)" "$epoch"
	done
)

provider_opencode() (
	# Only the Go subscription: the plain "opencode" key is Zen, which is metered.
	file=${XDG_DATA_HOME:-$HOME/.local/share}/opencode/auth.json
	[ -r "$file" ] || return "$RC_HIDDEN"
	token=$(json_flatten <"$file" | kv opencode-go.key)
	safe_token "$token" || return "$RC_HIDDEN"
	emit_plan Go

	code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
		http GET https://opencode.ai/zen/go/v1/usage)
	case $code in
	200) ;;
	403) return "$RC_HIDDEN" ;; # the key has no Go subscription
	*)
		http_failure "$code" "API key expired, create a new one in the OpenCode console"
		return
		;;
	esac

	data=$(json_flatten <"$AQ_BODY")
	for pair in rolling:5h weekly:7d monthly:mo; do
		key=usage.${pair%:*}
		used=$(get "$data" "$key.percent")
		[ -n "$used" ] || continue
		emit_win "${pair#*:}" "$used" "$(iso_epoch "$(get "$data" "$key.resetsAt")")"
	done
)

provider_freebuff() (
	file=${XDG_CONFIG_HOME:-$HOME/.config}/manicode/credentials.json
	[ -r "$file" ] || return "$RC_HIDDEN"
	token=$(json_flatten <"$file" | kv default.authToken)
	safe_token "$token" || return "$RC_HIDDEN"
	emit_plan Free

	# GET is read-only here, it does not start or rotate a Freebuff session.
	code=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
		http GET https://www.codebuff.com/api/v1/freebuff/session)
	[ "$code" = 200 ] || {
		http_failure "$code" "login expired, open freebuff once to renew it"
		return
	}

	data=$(json_flatten <"$AQ_BODY")
	limit=$(get "$data" freebucks.daily.limit)
	spent=$(get "$data" freebucks.daily.spent)
	[ -n "$limit" ] || return "$RC_HIDDEN"
	emit_win day "$(calc "${spent:-0}" "$limit" pct)" "$(iso_epoch "$(get "$data" freebucks.daily.resetAt)")"
)

# ------------------------------------------------------------------ cache ----

# Remove anything that could drive the terminal or be expanded by a prompt.
sanitize() {
	LC_ALL=C tr -cd '\11\12\40-\176' | LC_ALL=C tr -d '$`\\"'
}

cache_field() {
	[ -r "$1" ] && awk -F "$TAB" -v k="$2" '$1 == k { print $2; exit }' "$1"
}

refresh_one() (
	name=$1
	file=$CACHE_DIR/$name.tsv
	tmp=$file.$$
	AQ_BODY=$tmp.body
	trap 'rm -f "$tmp" "$AQ_BODY"' EXIT

	if command -v curl >/dev/null 2>&1; then
		out=$("provider_$name" 2>/dev/null)
		rc=$?
	else
		out=$(emit_msg "curl not found")
		rc=$RC_ERROR
	fi
	stamp=$(now)

	{
		printf 'checked\t%s\n' "$stamp"
		case $rc in
		"$RC_OK")
			printf 'state\tok\nfetched\t%s\n%s\n' "$stamp" "$out"
			;;
		"$RC_HIDDEN")
			printf 'state\thidden\nmsg\tno flat subscription found\n'
			;;
		*)
			# Keep the last known numbers: they are better than nothing, and the
			# renderer marks them as approximate.
			[ "$rc" = "$RC_AUTH" ] && printf 'state\tauth\n' || printf 'state\terror\n'
			printf '%s\n' "$out"
			printf 'fetched\t%s\n' "$(cache_field "$file" fetched)"
			printf 'oldplan\t%s\n' "$(cache_field "$file" plan)"
			[ -r "$file" ] && grep "^win$TAB" "$file"
			;;
		esac
	} | sanitize >"$tmp"
	mv -f "$tmp" "$file"
)

is_stale() {
	checked=$(cache_field "$CACHE_DIR/$1.tsv" checked)
	[ -z "$checked" ] && return 0
	[ "$(($(now) - checked))" -ge "$AIQUOTA_TTL" ]
}

display_list() {
	printf '%s\n' "$AIQUOTA_DISPLAY" | tr ',' ' '
}

# Reject unknown names right away, so that a typo does not silently hide a row.
check_display() {
	for p in $(display_list); do
		case " $KNOWN_ACCOUNTS " in
		*" $p "*) ;;
		*)
			echo "aiquota: unknown account '$p' (available: $KNOWN_ACCOUNTS)" >&2
			return 2
			;;
		esac
	done
}

# True when at least one account was chosen.
has_display() {
	[ -n "$(display_list | tr -d ' ')" ]
}

# refresh_all [force]: query what is stale, in parallel, then update the title.
refresh_all() {
	mkdir -p "$CACHE_DIR" 2>/dev/null || return 1
	for p in $(display_list); do
		if [ "${1:-}" = force ] || is_stale "$p"; then
			refresh_one "$p" &
		fi
	done
	wait
	render title >"$CACHE_DIR/title.$$" && mv -f "$CACHE_DIR/title.$$" "$CACHE_DIR/title"
}

# Never block the shell: detach, and let only one refresh run at a time.
refresh_background() {
	mkdir -p "$CACHE_DIR" 2>/dev/null || return 0
	(
		lock=$CACHE_DIR/lock
		if ! mkdir "$lock" 2>/dev/null; then
			pid=$(cat "$lock/pid" 2>/dev/null)
			if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
				exit 0
			fi
			rm -rf "$lock"
			mkdir "$lock" 2>/dev/null || exit 0
		fi
		trap 'rm -rf "$lock"' EXIT
		sh -c 'echo "$PPID"' >"$lock/pid" # $$ would be the parent in a subshell
		refresh_all
	) </dev/null >/dev/null 2>&1 &
}

# -------------------------------------------------------------- rendering ----

use_color() {
	[ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ] && [ -t 1 ]
}

use_unicode() {
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
	*UTF-8* | *utf8* | *utf-8* | *UTF8*) [ -z "${AIQUOTA_ASCII:-}" ] ;;
	*) return 1 ;;
	esac
}

color_depth() {
	case ${TERM:-} in *256color*) echo 256 ;; *) [ -n "${COLORTERM:-}" ] && echo 256 || echo 16 ;; esac
}

# Set $cols to the width of the terminal on stdout, or 0 when unknown. Not called
# through $(...), where stdout would be a pipe instead of the terminal.
read_cols() {
	{ size=$(stty size <&3 2>/dev/null); } 3<&1
	cols=${size##* }
	case $cols in '' | 0 | *[!0-9]*) cols=${COLUMNS:-0} ;; esac
	case $cols in *[!0-9]*) cols=0 ;; esac
}

# render table|line|title: draw what is in the cache, in provider order.
render() {
	rmode=$1
	set --
	for p in $(display_list); do
		[ -r "$CACHE_DIR/$p.tsv" ] && set -- "$@" "$CACHE_DIR/$p.tsv"
	done
	color=0
	unicode=0
	[ "$rmode" != title ] && use_color && color=1
	[ "${AIQUOTA_PLAIN:-}" = 1 ] && color=0
	use_unicode && unicode=1
	depth=0
	cols=0
	if [ "$rmode" = line ] && [ "$color" = 1 ]; then
		depth=$(color_depth)
		read_cols
	fi
	# Bytes mode: the program writes UTF-8 byte by byte, and all other text is ASCII.
	LC_ALL=C awk -F "$TAB" -v mode="$rmode" -v now="$(now)" -v color="$color" -v uni="$unicode" \
		-v depth="$depth" -v cols="$cols" -v blank="${LINE_BLANK:-0}" \
		-v ttl="$AIQUOTA_TTL" '
	function paint(c, t) { return color ? "\033[" c "m" t "\033[0m" : t }
	function level(l) { return l >= 50 ? "32" : l >= 20 ? "33" : "31" }
	function dur(s,   d, h, m, sp) {
		sp = (mode == "table") ? " " : ""
		if (s < 60) return "<1m"
		d = int(s / 86400); h = int(s % 86400 / 3600); m = int(s % 3600 / 60)
		if (d > 0) return d "d" sp h "h"
		if (h > 0) return h "h" sp m "m"
		return m "m"
	}
	function bar(l,   i, w, on, off) {
		w = int(l * 16 / 100 + 0.5); on = off = ""
		for (i = 0; i < 16; i++) {
			if (i < w) on = on (uni ? "\342\226\210" : "#")
			else off = off (uni ? "\342\226\221" : "-")
		}
		return paint(level(l), on) paint("2", off)
	}
	# The band: one uniform background. Only the dots carry the traffic-light color.
	function sgr(fg, bold,   f) {
		if (depth == 256) {
			f = fg == "ok" ? 46 : fg == "warn" ? 220 : fg == "bad" ? 203 : fg == "none" ? 245 : fg == "dim" ? 248 : 255
			return "\033[0;" (bold ? "1;" : "") "48;5;236;38;5;" f "m"
		}
		f = fg == "ok" ? 92 : fg == "warn" ? 93 : fg == "bad" ? 91 : (fg == "none" || fg == "dim") ? 37 : 97
		return "\033[0;" (bold ? "1;" : "") "40;" f "m"
	}
	# Draw section i. Level 2 is complete, level 1 drops the plan name.
	function section(i, lvl,   k, l, low, sev, t, v, d) {
		low = 101
		for (k = 1; k <= nw[i]; k++) if (wp[i, k] < low) low = wp[i, k]
		sev = nw[i] == 0 ? (state[i] == "ok" ? "ok" : "none") : low >= 50 ? "ok" : low >= 20 ? "warn" : "bad"
		t = sgr(sev, 0) " " (uni ? "\342\227\217" : "*") sgr("", 1) " " name[i]; secw = 3 + length(name[i])
		if (lvl >= 2 && plan[i] != "") { t = t sgr("", 0) " " plan[i]; secw += 1 + length(plan[i]) }
		if (nw[i] == 0) {
			v = state[i] == "auth" ? "login expired" : state[i] == "error" ? "unavailable" : "no limits"
			t = t sgr("dim", 0) " [" v "]"; secw += 3 + length(v)
		}
		for (k = 1; k <= nw[i]; k++) {
			l = wp[i, k]
			t = t sgr("dim", 0) " [" wl[i, k] " "; secw += 3 + length(wl[i, k])
			v = (wa[i, k] ? "~" : "") l "%"
			t = t sgr("", 1) v; secw += length(v)
			if (l < 50 && wr[i, k] > now) {
				d = dur(wr[i, k] - now)
				t = t sgr("dim", 0) (uni ? " \342\206\273" : " in ") d
				secw += (uni ? 2 : 4) + length(d)
			}
			t = t sgr("dim", 0) "]"; secw++
		}
		return t sgr("", 0) " "
	}
	# Paint the rest of the row, with the name at the far right if there is room.
	function fill(used, label,   left, t) {
		t = sgr("", 0); left = cols - 1 - used
		if (label && cols > 0 && left >= 9) t = t sprintf("%" (left - 8) "s", "") sgr("none", 0) "AIQuota "
		else if (cols > 0 && left > 0) t = t sprintf("%" left "s", "")
		return t "\033[K\033[0m"
	}
	function band(   lvl, i, w, row, bar) {
		bar = sgr("dim", 0) (uni ? "\342\224\203" : "|")
		for (lvl = 2; lvl >= 1; lvl--) {
			row = ""; w = 0
			for (i = 1; i <= nsec; i++) {
				row = row (i > 1 ? bar : "") section(vis[i], lvl)
				w += secw + 1 + (i > 1 ? 1 : 0)
			}
			if (cols == 0 || w < cols) { print row fill(w, 1); return }
		}
		# Too narrow even when compact: one complete section per row.
		for (i = 1; i <= nsec; i++) {
			row = section(vis[i], 2)
			print row fill(secw + 1, i == 1)
		}
	}
	function pretty_name(n) {
		if (n == "claude") return "Claude"
		if (n == "codex") return "ChatGPT"
		if (n == "gemini") return "Gemini"
		if (n == "copilot") return "Copilot"
		if (n == "opencode") return "OpenCode"
		if (n == "freebuff") return "Freebuff"
		return n
	}
	FNR == 1 {
		c++; f = FILENAME; sub(/.*\//, "", f); sub(/\.tsv$/, "", f)
		name[c] = pretty_name(f); nw[c] = 0
	}
	$1 == "state" { state[c] = $2 }
	$1 == "plan" { plan[c] = $2 }
	$1 == "oldplan" { if ($2 != "" && plan[c] == "") plan[c] = $2 }
	$1 == "msg" { msg[c] = $2 }
	$1 == "fetched" { fetched[c] = $2 + 0 }
	$1 == "win" {
		k = ++nw[c]; wl[c, k] = $2; wr[c, k] = $4 + 0
		u = $3 + 0; l = int(100 - u + 0.5)
		if (l < 0) l = 0
		if (l > 100) l = 100
		wa[c, k] = (state[c] != "ok" || now - fetched[c] > ttl * 12) ? 1 : 0
		# The window reset after our last look, so it restarted from full.
		if (wr[c, k] > 0 && wr[c, k] <= now) { l = 100; wa[c, k] = 1 }
		wp[c, k] = l
	}
	END {
		sep = uni ? " \342\224\202 " : " | "
		out = ""
		for (i = 1; i <= c; i++) {
			if (state[i] == "hidden" && mode != "table") continue
			if (mode == "table") {
				printf "%s %s", paint("1", sprintf("%-9s", name[i])), sprintf("%-14s", plan[i])
				if (nw[i] == 0) printf "%s", paint("2", msg[i] != "" ? msg[i] : "no limits")
				for (k = 1; k <= nw[i]; k++) {
					l = wp[i, k]
					if (k > 1) printf "%24s", ""
					printf "%-8s%s %s  %s", wl[i, k], bar(l),
						paint(level(l), sprintf("%s%3d%%", wa[i, k] ? "~" : " ", l)),
						(wr[i, k] > now ? paint("2", "resets in " dur(wr[i, k] - now)) : "")
					if (k < nw[i]) printf "\n"
				}
				printf "\n"
				if (nw[i] > 0 && msg[i] != "") printf "%24s%s\n", "", paint("2", msg[i])
			} else if (mode == "line") {
				vis[++nsec] = i
				s = name[i] (plan[i] != "" ? " " plan[i] : "")
				if (nw[i] == 0 && state[i] == "auth") s = s " [login expired]"
				else if (nw[i] == 0 && state[i] == "error") s = s " [unavailable]"
				for (k = 1; k <= nw[i]; k++) {
					l = wp[i, k]
					s = s " [" wl[i, k] " " (wa[i, k] ? "~" : "") l "%"
					if (l < 50 && wr[i, k] > now) s = s " " (uni ? "\342\206\273" : "in ") dur(wr[i, k] - now)
					s = s "]"
				}
				out = out (out == "" ? "" : sep) s
			} else {
				# Title: only the window that will stop you first.
				b = 0
				for (k = 1; k <= nw[i]; k++) if (!b || wp[i, k] < wp[i, b]) b = k
				s = name[i]
				if (b) {
					s = s " " (wa[i, b] ? "~" : "") wp[i, b] "%"
					if (wp[i, b] < 50 && wr[i, b] > now) s = s " " dur(wr[i, b] - now)
				} else if (state[i] != "ok") s = s " ?"
				out = out (out == "" ? "" : sep) s
			}
		}
		if (mode == "line" && depth > 0 && nsec > 0) band()
		else if (mode == "line" && out != "") print out
		if (mode == "line" && blank && nsec > 0) print ""
		if (mode == "title") print (out == "" ? "AIQuota: no subscriptions" : out)
	}' /dev/null "$@"
}

# ------------------------------------------------------------- shell hooks ----

shell_quote() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

self_path() {
	case $SELF in
	/*) printf '%s' "$SELF" ;;
	*/*) printf '%s/%s' "$(cd "$(dirname "$SELF")" && pwd)" "$(basename "$SELF")" ;;
	*) command -v "$SELF" ;;
	esac
}

# Print the snippet for `eval "$(aiquota init <shell>)"`. It only ever reads the
# cache, so opening a terminal stays instant whatever the network is doing.
cmd_init() {
	if ! has_display; then
		echo "aiquota: choose your accounts, e.g. aiquota init ${1:-bash} --display=claude,codex" >&2
		return 2
	fi
	bin=$(shell_quote "$(self_path)")
	cache=$(shell_quote "$CACHE_DIR")
	accounts=$(shell_quote "$AIQUOTA_DISPLAY")
	banner=line
	[ "${NO_BLANK_LINE:-0}" = 1 ] || banner="line --blank-line"
	case ${1:-} in
	bash)
		cat <<EOF
if [[ \$- == *i* ]]; then
export AIQUOTA_DISPLAY=$accounts
__aiquota_bin=$bin
__aiquota_cache=$cache
__aiquota_last=-60
__AIQUOTA_TITLE=
__aiquota_prompt() {
  local rc=\$?
  if (( SECONDS - __aiquota_last >= 60 )); then
    __aiquota_last=\$SECONDS
    "\$__aiquota_bin" refresh --background
  fi
EOF
		[ "$AIQUOTA_TITLE" = 1 ] && cat <<'EOF'
  if [[ -r $__aiquota_cache/title ]]; then
    IFS= read -r __AIQUOTA_TITLE <"$__aiquota_cache/title"
  fi
  # Default prompts set the title in PS1, so the only way to win is to come last.
  case $PS1 in
    *__AIQUOTA_TITLE*) ;;
    *) PS1=$PS1'\[\e]2;${__AIQUOTA_TITLE:-AIQuota}\a\]' ;;
  esac
EOF
		cat <<'EOF'
  return $rc
}
if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
  PROMPT_COMMAND+=(__aiquota_prompt)
else
  PROMPT_COMMAND=${PROMPT_COMMAND%;}
  PROMPT_COMMAND=${PROMPT_COMMAND:+$PROMPT_COMMAND;}__aiquota_prompt
fi
EOF
		[ "$AIQUOTA_BANNER" = 1 ] && printf '"$__aiquota_bin" %s\n' "$banner"
		printf 'fi\n'
		;;
	zsh)
		cat <<EOF
if [[ -o interactive ]]; then
export AIQUOTA_DISPLAY=$accounts
typeset -g __aiquota_bin=$bin
typeset -g __aiquota_cache=$cache
typeset -gi __aiquota_last=-60
__aiquota_precmd() {
  if (( SECONDS - __aiquota_last >= 60 )); then
    __aiquota_last=\$SECONDS
    "\$__aiquota_bin" refresh --background
  fi
EOF
		[ "$AIQUOTA_TITLE" = 1 ] && cat <<'EOF'
  local title
  if [[ -r $__aiquota_cache/title ]] && IFS= read -r title <"$__aiquota_cache/title"; then
    printf '\033]2;%s\007' "$title"
  fi
EOF
		cat <<'EOF'
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd __aiquota_precmd
EOF
		[ "$AIQUOTA_BANNER" = 1 ] && printf '"$__aiquota_bin" %s\n' "$banner"
		printf 'fi\n'
		;;
	fish)
		cat <<EOF
if status is-interactive
set -gx AIQUOTA_DISPLAY $accounts
set -g __aiquota_bin $bin
set -g __aiquota_cache $cache
set -g __aiquota_last 0
function __aiquota_refresh --on-event fish_prompt
  set -l t (date +%s)
  if test (math \$t - \$__aiquota_last) -ge 60
    set -g __aiquota_last \$t
    \$__aiquota_bin refresh --background
  end
end
EOF
		[ "$AIQUOTA_TITLE" = 1 ] && cat <<'EOF'
function fish_title
  if test -r $__aiquota_cache/title
    read -l t <$__aiquota_cache/title
    echo $t
  else
    echo AIQuota
  end
end
EOF
		[ "$AIQUOTA_BANNER" = 1 ] && printf '$__aiquota_bin %s\n' "$banner"
		printf 'end\n'
		;;
	sh | dash | ash | ksh | mksh | yash)
		# No portable prompt hook here: update once, when the shell starts.
		cat <<EOF
case \$- in *i*)
  AIQUOTA_DISPLAY=$accounts
  export AIQUOTA_DISPLAY
  $bin refresh --background
EOF
		[ "$AIQUOTA_TITLE" = 1 ] && printf '  %s title\n' "$bin"
		[ "$AIQUOTA_BANNER" = 1 ] && printf '  %s %s\n' "$bin" "$banner"
		printf ';; esac\n'
		;;
	*)
		echo "aiquota: unsupported shell '${1:-}' (bash, zsh, fish, sh, dash, ash, ksh, mksh, yash)" >&2
		return 2
		;;
	esac
}

# --------------------------------------------------------------- commands ----

usage() {
	cat <<EOF
AIQuota $AIQUOTA_VERSION - remaining quota of your flat-rate AI subscriptions.

Set it up once. The accounts you list are the ones shown, in that order:
  aiquota install --display=codex,claude,copilot,freebuff

This adds one line to your shell startup file, which you can also write yourself:
  bash  eval "\$(aiquota init bash --display=codex,claude)"    (~/.bashrc)
  zsh   eval "\$(aiquota init zsh --display=codex,claude)"     (~/.zshrc)
  fish  aiquota init fish --display=codex,claude | source      (config.fish)
Keep it as the last line, so that it runs after any prompt theme.

Accounts: $KNOWN_ACCOUNTS

Commands:
  aiquota                  Show quota and reset times, refreshing if stale
  aiquota line [--plain]   One line from the cache, for banners and status bars
  aiquota title            Put the summary in the terminal title bar
  aiquota refresh [--force | --background]
  aiquota install [shell]  Add or update the startup line (needs --display)
  aiquota init <shell>     Print the hook: bash zsh fish sh dash ash ksh mksh yash
  aiquota version | help

Any command accepts --display=a,b to override the configured accounts.
With install and init, --no-blank-line removes the empty line after the band.

Settings, as environment variables or in $CONFIG_FILE:
  AIQUOTA_TTL         seconds between refreshes (now $AIQUOTA_TTL)
  AIQUOTA_TIMEOUT     seconds per request (now $AIQUOTA_TIMEOUT)
  AIQUOTA_BANNER=0    no line when a terminal opens
  AIQUOTA_TITLE=0     leave the title bar alone
  AIQUOTA_ASCII=1     no Unicode bars (NO_COLOR also works)

A "~" before a value means it may be out of date: the login expired, the network
failed, or the window has reset since the last successful check.
EOF
}

# Add the startup line, or replace the previous one when the accounts change.
cmd_install() {
	if ! has_display; then
		echo "aiquota: choose your accounts, e.g. aiquota install --display=claude,codex" >&2
		return 2
	fi
	shell_name=${1:-$(basename "${SHELL:-sh}")}
	# An absolute path, because IDEs started from a desktop menu may have a shorter PATH.
	me=$(self_path)
	accounts=$(display_list | awk '{ $1 = $1; gsub(/ /, ","); print }')
	[ "${NO_BLANK_LINE:-0}" = 1 ] && accounts="$accounts --no-blank-line"
	case $shell_name in
	bash) rc=$HOME/.bashrc ;;
	zsh) rc=${ZDOTDIR:-$HOME}/.zshrc ;;
	fish) rc=${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish ;;
	ksh | mksh) rc=$HOME/.kshrc ;;
	sh | dash | ash | yash) rc=$HOME/.profile ;;
	*)
		echo "aiquota: unsupported shell '$shell_name'" >&2
		return 2
		;;
	esac
	if [ "$shell_name" = fish ]; then
		line="$me init fish --display=$accounts | source"
	else
		line="eval \"\$($me init $shell_name --display=$accounts)\""
	fi

	mkdir -p "$(dirname "$rc")" || return 1
	tmp=$CACHE_DIR/rc.$$
	mkdir -p "$CACHE_DIR" || return 1
	if [ -f "$rc" ]; then
		grep -v 'aiquota.* init .*--display=' "$rc" >"$tmp"
	else
		: >"$tmp"
	fi
	printf '%s\n' "$line" >>"$tmp"
	# Not mv: the startup file is often a symlink into a dotfiles repository.
	cat "$tmp" >"$rc" && rm -f "$tmp"
	echo "Updated $rc:"
	echo "  $line"
	refresh_all
	render table
	echo "Open a new terminal to see it in the title bar."
}

cmd_title() {
	[ "${TERM:-dumb}" != dumb ] || return 0
	[ -r "$CACHE_DIR/title" ] || return 0
	IFS= read -r text <"$CACHE_DIR/title" || return 0
	if [ -t 1 ]; then
		printf '\033]2;%s\007' "$text"
	else
		{ printf '\033]2;%s\007' "$text" >/dev/tty; } 2>/dev/null
	fi
	return 0
}

main() {
	n=$#
	while [ "$n" -gt 0 ]; do
		arg=$1
		shift
		case $arg in
		--display=*) AIQUOTA_DISPLAY=${arg#*=} ;;
		--no-blank-line) NO_BLANK_LINE=1 ;;
		*) set -- "$@" "$arg" ;;
		esac
		n=$((n - 1))
	done
	check_display || return 2

	cmd=${1:-status}
	[ $# -gt 0 ] && shift
	case $cmd in
	status)
		if ! has_display; then
			echo "No accounts configured. Choose yours, in the order you want them:" >&2
			echo "  aiquota install --display=$(echo "$KNOWN_ACCOUNTS" | tr ' ' ',')" >&2
			return 2
		fi
		refresh_all
		render table
		;;
	line)
		for arg in "$@"; do
			case $arg in
			--plain) AIQUOTA_PLAIN=1 ;;
			--blank-line) LINE_BLANK=1 ;;
			esac
		done
		has_display && render line
		;;
	title) cmd_title ;;
	refresh)
		has_display || return 0
		case ${1:-} in
		--force) refresh_all force ;;
		--background) refresh_background ;;
		'') refresh_all ;;
		*)
			usage >&2
			return 2
			;;
		esac
		;;
	install) cmd_install "$@" ;;
	init) cmd_init "$@" ;;
	version | --version | -v) echo "aiquota $AIQUOTA_VERSION" ;;
	help | --help | -h) usage ;;
	*)
		usage >&2
		return 2
		;;
	esac
}

main "$@"
